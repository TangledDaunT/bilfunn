# ---------------------------------------------------------------------------
# Bilfunn — environment. Copy to .env.local for development,
# and add the same keys in Vercel → Project → Settings → Environment Variables.
# The app runs end to end with NONE of the optional keys set: any integration
# without credentials falls back to a clearly-labelled simulator.
# ---------------------------------------------------------------------------

# REQUIRED -------------------------------------------------------------------
# Postgres (Neon, Supabase, Vercel Postgres). Use the pooled URL for DATABASE_URL.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# 32+ random chars. Generate: openssl rand -base64 32
SESSION_SECRET=""

# Public base URL, no trailing slash. https://bilfunn.no in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Protects /api/cron/billing. Generate: openssl rand -hex 32
CRON_SECRET=""

# Comma-separated admin emails. These accounts see /admin.
ADMIN_EMAILS="you@example.no"

# VEHICLE DATA ---------------------------------------------------------------
# Statens vegvesen, open technical API (NO owner data). Free key, apply at:
# https://www.vegvesen.no/kjoretoy/kjop-og-salg/kjoretoyopplysninger/api-er-for-tekniske-kjoretoyopplysninger/
# Limit: 50 000 calls per key per 24h.
SVV_API_KEY=""
SVV_BASE_URL="https://www.vegvesen.no/ws/no/vegvesen/kjoretoy/felles/datautlevering/enkeltoppslag/kjoretoydata"

# Owner data requires a SEPARATE agreement with Statens vegvesen
# (Tekniske kjøretøyopplysninger med eierinformasjon) or a commercial reseller.
# Leave empty until the agreement is signed: the owner block stays hidden.
OWNER_API_KEY=""
OWNER_API_BASE_URL=""
OWNER_DATA_ENABLED="false"

# PAYMENTS -------------------------------------------------------------------
# mock | stripe | vipps | both
PAYMENTS_MODE="mock"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_INTRO=""      # price id, NOK 3 one-off
STRIPE_PRICE_MONTHLY=""    # price id, NOK 249 recurring monthly

# Vipps MobilePay Recurring API v3 — https://portal.vippsmobilepay.com
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
VIPPS_SUBSCRIPTION_KEY=""
VIPPS_MSN=""
VIPPS_BASE_URL="https://apitest.vipps.no"   # production: https://api.vipps.no
VIPPS_WEBHOOK_SECRET=""

# EMAIL ----------------------------------------------------------------------
# Without a key, emails are written to the database and the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Bilfunn <ikke-svar@bilfunn.no>"
SUPPORT_EMAIL="support@bilfunn.no"

# ANALYTICS (optional) -------------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# COMMERCIAL DEFAULTS (seeded into the DB, editable in /admin) ---------------
INTRO_PRICE_ORE="300"        # NOK 3.00
RENEWAL_PRICE_ORE="24900"    # NOK 249.00
INTRO_DAYS="3"
